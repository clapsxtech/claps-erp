{
  "private": true,
  "scripts": {
    "dev": "npm run development",
    "development": "node scripts/build-assets.mjs",
    "watch": "node scripts/build-assets.mjs --watch",
    "watch-poll": "node scripts/build-assets.mjs --watch",
    "hot": "node scripts/build-assets.mjs --watch",
    "prod": "npm run production",
    "production": "node scripts/build-assets.mjs --production",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run cf:assets && wrangler deploy",
    "cf:types": "wrangler types",
    "test:deployment": "node --test tests/Deployment/*.test.cjs",
    "build": "npm run production",
    "test:assets": "node --test tests/Assets/*.test.cjs",
    "test": "npm run typecheck && node --test tests/Assets/*.test.cjs tests/Deployment/*.test.cjs",
    "cf:assets": "npm run production && node scripts/stage-cloudflare-assets.mjs",
    "typecheck": "tsc -p resources/app/tsconfig.json"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.136.0"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@fontsource/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
